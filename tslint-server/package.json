{
  "name": "tslint-server",
  "version": "0.2.0",
  "description": "TSLint Linter Server",
  "engines": {
    "node": "*"
  },
  "private": true,
  "dependencies": {
    "minimatch": "^10.0.1",
    "vscode-languageserver": "^9.0.1",
    "semver": "^7.7.2",
    "vscode-uri": "^3.1.0"
  },
  "devDependencies": {
    "@types/minimatch": "^5.1.2",
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.15.30",
    "@types/semver": "^7.7.0",
    "mocha": "^11.5.0",
    "tslint": "^6.1.3",
    "typescript": "^5.8.3"
  },
  "scripts": {
    "compile": "installServerIntoExtension ../tslint ./package.json ./src/tsconfig.json && tsc -p ./src",
    "watch": "installServerIntoExtension ../tslint ./package.json ./src/tsconfig.json && tsc --watch -p ./src",
    "pretest": "tsc -p ./test",
    "test": "mocha test/out/test"
  }
}
